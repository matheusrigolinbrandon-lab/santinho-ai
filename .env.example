# ═══════════════════════════════════════════════════════════
# SANTINHO AI MVP — Variáveis de ambiente
# Copie para .env.local e preencha com seus valores reais
# ═══════════════════════════════════════════════════════════

# ── SUPABASE (obrigatório) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── ANTHROPIC (opcional no MVP, obrigatório para IA real) ─────
# Sem essa chave, o Santinho usa respostas locais estruturadas.
# Adicione para ativar Claude Sonnet automaticamente.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Modelo Claude — padrão seguro, pode trocar por claude-opus-4-6 etc.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OPENAI (apenas para RAG com embeddings) ───────────────────
# Só necessário se for rodar generate-embeddings.ts
OPENAI_API_KEY=sk-proj-...

# ── APP ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=Fundição Tropical
NEXT_PUBLIC_COMPANY_CITY=Maringá
NEXT_PUBLIC_COMPANY_STATE=PR

# WhatsApp Business (número de contato para o widget)
NEXT_PUBLIC_WHATSAPP_NUMBER=5544999999999

# ── WHATSAPP API (para integração futura) ─────────────────────
# Deixar em branco no MVP. Preencher ao integrar com Meta.
WHATSAPP_VERIFY_TOKEN=escolha_um_token_secreto_qualquer
WHATSAPP_TOKEN=EAAxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
